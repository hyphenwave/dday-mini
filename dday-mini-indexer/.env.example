# Solana Configuration
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_BACKUP_RPC=https://solana-api.projectserum.com
PROGRAM_ID=CS5ZMcpfdSS7WTgTQp7xYeVN9af3UoAdrZyMgKr3s8Bt
AUTHORITY_KEYPAIR_PATH=./authority-wallet.json

# Service Configuration
PRESIDENT_UPDATE_INTERVAL_MS=3600000  # 1 hour
PRICE_UPDATE_INTERVAL_MS=60000        # 1 minute
ENABLE_PRESIDENT_UPDATES=true
ENABLE_DRY_RUN=true

# Round Configuration
INITIAL_ROUND_DURATION_DAYS=7
MIN_ROUND_DURATION_HOURS=8
ROUND_DURATION_DECREASE_DAYS=1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_PORT=3000
ENABLE_WEBSOCKET=true

# Logging
LOG_LEVEL=debug
ENABLE_VERBOSE_LOGGING=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Node Environment
NODE_ENV=development