{
  "name": "world-pvp-indexer",
  "version": "1.0.0",
  "private": true,
  "description": "Indexer system for World PvP Solana game",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:start": "docker-compose up -d postgres redis",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres redis",
    "db:logs": "docker-compose logs -f postgres",
    "local:setup": "./scripts/setup-local.sh",
    "local:test": "node test/test-db-connection.js",
    "local:psql": "PGPASSWORD=doomsday_secure_pwd_2024 psql -U doomsday_admin -d doomsday_game",
    "dev": "concurrently \"npm run dev:*\"",
    "dev:president": "npm run dev --workspace=president-updater",
    "dev:price": "npm run dev --workspace=price-updater",
    "dev:round": "npm run dev --workspace=round-scheduler",
    "dev:migrator": "npm run dev --workspace=amm-migrator",
    "dev:buyback": "npm run dev --workspace=buyback-orchestrator",
    "dev:api": "npm run dev --workspace=api-gateway",
    "build": "tsc -b",
    "build:all": "npm run build --workspaces",
    "test": "node test/run-all-tests.js",
    "test:setup": "node test/phase1-setup.test.js",
    "test:health": "node test/service-health.test.js",
    "test:redis": "node test/redis-connection.test.js",
    "test:all": "npm run test --workspaces",
    "test:watch": "jest --watch",
    "clean": "npm run clean --workspaces && rimraf node_modules",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "typeorm": "^0.3.27"
  }
}
